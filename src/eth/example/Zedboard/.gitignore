# Vivado build directory.  Everything in it is generated by make - the project,
# the runs, the IP, the reports, the bitstreams and the tcl vivado.mk writes -
# so ignore the lot and whitelist what is actually source.
fpga/fpga/*
!fpga/fpga/Makefile

# cocotb and hardware-manager output
*.log

# drawio autosave
.$*.drawio.*
